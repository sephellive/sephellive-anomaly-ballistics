local exact = {
 ["ammo_9x19_fmj"]="9x19_fmj", ["ammo_9x19_pbp"]="9x19_ap", ["ammo_9x19_ap"]="9x19_ap",
 ["ammo_5.45x39_fmj"]="545_fmj", ["ammo_5.45x39_ep"]="545_fmj", ["ammo_5.45x39_ap"]="545_ap",
 ["ammo_5.56x45_fmj"]="556_fmj", ["ammo_5.56x45_ss190"]="556_ap", ["ammo_5.56x45_ap"]="556_ap",
 ["ammo_7.62x39_fmj"]="76239_fmj", ["ammo_7.62x39_ap"]="76239_ap",
 ["ammo_7.62x51_fmj"]="76251_fmj", ["ammo_7.62x51_ap"]="76251_ap",
 ["ammo_7.62x54_7h1"]="76254_fmj", ["ammo_7.62x54_7h14"]="76254_ap", ["ammo_7.62x54_ap"]="76254_ap",
 ["ammo_12x70_buck"]="12_buck", ["ammo_12x70_buck_self"]="12_buck", ["ammo_12x76_zhekan"]="12_slug", ["ammo_12x76_dart"]="12_slug", ["ammo_12x76_bull"]="12_slug",
}
local fallback = {caliber="unknown", mass_g=7, muzzle_velocity=400, penetration=18, retention=0.002, drag=0.002, tissue=15, blunt=0.1, kind="FALLBACK"}
function resolve(section)
 local key = tostring(section or ""):lower():gsub("_verybad$", ""):gsub("_bad$", "")
 local id = exact[key]
 return profiles[id] or fallback, id or "fallback", not id
end
