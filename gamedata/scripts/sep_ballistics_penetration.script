function impact(profile, distance, muzzle_factor)
 local d = math.max(0, tonumber(distance) or 0)
 local v = profile.muzzle_velocity * (muzzle_factor or 1) * math.exp(-(profile.drag or 0.002) * d)
 local e = 0.5 * (profile.mass_g / 1000) * v * v
 return v, e, profile.penetration * math.exp(-(profile.retention or 0.001) * d)
end
function resolve(capability, resistance, rng)
 local ratio = capability / math.max(0.01, resistance or 0)
 -- Two curves avoid treating every failed borderline penetration as PARTIAL.
 -- p_penetrate rises around parity; p_stop falls more slowly below parity.
 local p_penetrate = 1 / (1 + math.exp(-5.5 * (ratio - 1.0)))
 local p_stop = 1 / (1 + math.exp(5.0 * (ratio - 0.72)))
 local p_partial = math.max(0, 1 - p_penetrate - p_stop)
 local total = p_penetrate + p_stop + p_partial
 p_penetrate, p_stop, p_partial = p_penetrate / total, p_stop / total, p_partial / total
 local roll = (rng and rng()) or math.random()
 if roll <= p_penetrate then return "PENETRATED", p_penetrate, roll, ratio, p_partial end
 if roll <= p_penetrate + p_partial then return "PARTIAL", p_penetrate, roll, ratio, p_partial end
 return "STOPPED", p_penetrate, roll, ratio, p_partial
end
