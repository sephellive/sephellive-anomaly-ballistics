-- P0 probe mode: custom damage is disabled until live telemetry proves all inputs.
local pending_actor_hits = {}
function actor_on_before_hit(s_hit, bone)
 local core = sep_ballistics_core
 if not core then return end
 local draft = s_hit and s_hit.draftsman
 local result = core.from_engine(db and db.actor, s_hit, s_hit and s_hit.power, draft, bone)
 if result then pending_actor_hits[#pending_actor_hits + 1] = result end
end
function actor_on_update()
 -- FIFO: every valid hit is processed exactly once; no single pending-hit slot
 -- can overwrite automatic-fire or shotgun events between updates.
 local debug, sink = sep_ballistics_debug, sep_ballistics_sink
 while #pending_actor_hits > 0 do
  local result = table.remove(pending_actor_hits, 1)
  local mode, reason = "native_fallback", "sink unavailable"
  if sink and type(sink.deliver_actor) == "function" then
   mode, reason = sink.deliver_actor(result)
  end
  result.sink = mode
  result.runtime = result.runtime or {}
  result.runtime.sink_reason = reason
  if debug and type(debug.emit) == "function" then debug.emit(result) end
 end
end
function npc_on_before_hit(obj, hit, bone_id, flags)
 local core, debug = sep_ballistics_core, sep_ballistics_debug
 if not core or not debug then return false end
 local r=core.from_engine(obj,hit,bone_id,hit and hit.draftsman,bone_id)
 if r then
  debug.emit(r)
 end
 return false
end
function on_game_start()
 RegisterScriptCallback("actor_on_before_hit", actor_on_before_hit)
 RegisterScriptCallback("actor_on_update", actor_on_update)
 RegisterScriptCallback("npc_on_before_hit", npc_on_before_hit)
end
