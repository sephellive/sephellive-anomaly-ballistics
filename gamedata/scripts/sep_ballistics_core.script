function calculate(input)
 local ammo, pen, debug = sep_ballistics_ammo, sep_ballistics_penetration, sep_ballistics_debug
 if not ammo or not pen or not debug then return nil, "ballistics modules unavailable" end
 local profile, profile_id, unknown = ammo.resolve(input.ammo_id)
 if unknown then debug.warn_unknown(input.ammo_id, input.weapon_id) end
 local velocity, energy, capability = pen.impact(profile, input.distance_m, input.muzzle_factor)
 local resistance = math.max(0, tonumber(input.armor_resistance) or 0)
 local outcome, chance, roll, ratio, partial_chance = pen.resolve(capability, resistance, input.rng)
 local residual_fraction = 0
 if outcome == "PENETRATED" then
  residual_fraction = math.min(0.95, math.max(0.12, 0.20 + 0.55 * math.min(ratio, 1.35)))
 elseif outcome == "PARTIAL" then
  residual_fraction = math.min(0.32, math.max(0.04, 0.05 + 0.15 * math.min(ratio, 1.5)))
 end
 local residual = energy * residual_fraction
 local terminal = profile.tissue * residual_fraction * (profile.terminal_multiplier or 1)
 if outcome == "STOPPED" then terminal = 0 end
 local blunt = energy / 1000 * profile.blunt * (outcome == "PENETRATED" and .25 or 1)
 return {weapon_id=input.weapon_id or "unknown", ammo_id=input.ammo_id or "unknown", profile_id=profile_id, distance_m=math.max(0,input.distance_m or 0), hit_zone=input.hit_zone or "TORSO", impact_velocity=velocity, impact_energy=energy, armor={encountered=resistance>0,resistance=resistance,penetration_chance=chance,penetration_roll=roll,penetration_ratio=ratio,partial_chance=partial_chance,penetration_result=outcome,degradation=energy/1000*(outcome=="PENETRATED" and 1 or .4)}, projectile={residual_energy=residual,residual_penetration=capability * residual_fraction,deformation_factor=1-residual_fraction,deformation=outcome=="STOPPED" and "stopped" or "deformed",fragmentation=profile.kind=="HP"},body={tissue_damage=terminal,bleeding=terminal*(profile.kind=="HP" and .85 or .35),blunt_trauma=blunt,shock=blunt*.5},sink="native_fallback"}
end
function from_engine(target, hit, amount, shooter, bone)
 -- Native APIs do not expose shot distance/ammo consistently; retain native damage as
 -- the fallback and only replace it when an explicit ammo section can be resolved.
 local weapon_resolver, zones, armor_resolver = sep_ballistics_weapon_resolver, sep_ballistics_hit_zones, sep_ballistics_armor
 if not weapon_resolver or not zones or not armor_resolver then return nil, "ballistics modules unavailable" end
 local weapon_data, reason = weapon_resolver.resolve_weapon(shooter)
 if not weapon_data then return nil, reason end
 local distance = 0
 if target and shooter and target.position and shooter.position then
  local a,b=target:position(),shooter:position(); if a and b then distance=a:distance_to(b) end
 end
 local hit_zone = zones.normalize(bone)
 local armor = armor_resolver.resolve(target, hit_zone, bone)
 -- Probe pass intentionally does not apply weapon speed or armour to damage. Both
 -- values are captured first and must be proven through a live game log.
 local result = calculate({weapon_id=weapon_data.weapon_section,ammo_id=weapon_data.ammo_section,distance_m=distance,hit_zone=hit_zone,armor_resistance=armor.resistance})
 if not result then return nil, "ballistics calculation unavailable" end
 result.armor.source, result.armor.durability, result.armor.material, result.armor.bone_id = armor.source, armor.durability, armor.material, armor.bone_id
 result.runtime = {ammo_index=weapon_data.ammo_index, weapon_bullet_speed=weapon_data.bullet_speed, resolver_reason=reason, armor_source=armor.source}
 return result
end
